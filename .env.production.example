# Production Environment Variables
# Copy this to .env for production deployment

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_production_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_production_anon_key
VITE_SUPABASE_URL=https://your-production-project.supabase.co

# Instructions for Production:
# 1. Get credentials from Supabase Dashboard → Settings → API
# 2. Use PRODUCTION project credentials (not development)
# 3. Set these in your deployment platform's environment variables:
#    - Netlify: Site settings → Environment variables
#    - Vercel: Project settings → Environment Variables
# 4. Never commit actual credentials to version control
